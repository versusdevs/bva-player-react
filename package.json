{
  "name": "bva-player-react",
  "version": "0.1.0",
  "description": "React players for Baked Vector Animation, WebP/CSS animations, and GameField scenes",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./gamefield.css": "./src/gamefield/gamefield.css",
    "./css": {
      "types": "./src/CssAnimationPlayer.tsx",
      "import": "./src/CssAnimationPlayer.tsx",
      "default": "./src/CssAnimationPlayer.tsx"
    },
    "./css-animation.css": "./src/css-animation.css",
    "./music-fade": {
      "types": "./src/gamefield/musicFade.ts",
      "default": "./src/gamefield/musicFade.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "./src/gamefield/gamefield.css",
    "./src/css-animation.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5"
  },
  "keywords": [
    "bva",
    "svg",
    "animation",
    "react",
    "lottie"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "web-haptics": "0.0.6"
  }
}
